# ── Google Custom Search (OPTIONAL - for Google tender search) ────────────────
# Only needed if you want the Google search feature.
# 100 free searches/day.
# Step 1: https://developers.google.com/custom-search/v1/introduction
# Step 2: https://cse.google.com (create a search engine, set to search whole web)
GOOGLE_API_KEY=AIzaSyD4ZzBaTXWzMG0CSGDSMHdlCAWkJqJLabY
GOOGLE_CSE_ID=10b5f80f5d06e4dda
# ── Excel file path ───────────────────────────────────────────────────────────
# Full path to your Tender_List.xlsx file.
# Windows example: C:\Users\YourName\Documents\Tender_List.xlsx
# Mac/Linux example: /home/yourname/Documents/Tender_List.xlsx
# Leave blank to use the default: tender_agent/data/Tender_List.xlsx
EXCEL_PATH=

# ── Scraping schedule ─────────────────────────────────────────────────────────
# How many hours between scraping runs.
# 6 = check every 6 hours (4 times a day)
SCRAPE_INTERVAL_HOURS=6
